# ========================================
# MTHS Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_URL=jdbc:postgresql://localhost:5432/mthsdb1
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# ========================================
# JWT CONFIGURATION
# ========================================
# Generate a strong random secret (min 64 characters)
# You can use: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_64_characters_required
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ========================================
# SUPER ADMIN CONFIGURATION
# ========================================
SUPERADMIN_EMAIL=superadmin@healthcare.com
SUPERADMIN_PASSWORD=your_strong_password_here
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Administrator

# ========================================
# MINIO CONFIGURATION
# ========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# ========================================
# MAIL CONFIGURATION
# ========================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEBUG=false

# ========================================
# PAYSTACK PAYMENT CONFIGURATION
# ========================================
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8081

# ========================================
# FRONTEND CONFIGURATION
# ========================================
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
FRONTEND_BASE_URL=http://localhost:3000

# ========================================
# PAYMENT CONFIGURATION
# ========================================
CONSULTATION_FEE=10000.00
PAYMENT_CURRENCY=NGN

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=DEBUG
