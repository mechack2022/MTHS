# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/auth_service_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Server Configuration
SERVER_PORT=8081

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-here-make-it-very-long-and-secure
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Super Admin Configuration
SUPERADMIN_EMAIL=superadmin@healthcare.com
SUPERADMIN_PASSWORD=SuperAdmin123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Administrator

# MinIO Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Frontend Configuration
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,https://your-frontend-domain.com
FRONTEND_BASE_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=DEBUG

# Email Configuration (if using email service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password